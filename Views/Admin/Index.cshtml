@model IEnumerable<Web.Models.Order>

@{
    ViewData["Title"] = "Quản lý Đơn hàng";
}

<div class="container mt-5">
    <h2 class="mb-4 text-primary"><i class="fas fa-boxes"></i> Quản lý Đơn hàng</h2>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive shadow-sm rounded">
            <table class="table table-hover table-bordered bg-white mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Mã ĐH</th>
                        <th>Ngày đặt</th>
                        <th>Khách hàng</th>
                        <th>Số điện thoại</th>
                        <th>Địa chỉ</th>
                        <th>Tổng tiền</th>
                        <th class="text-center">Chi tiết</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var order in Model)
                    {
                        <tr>
                            <td class="fw-bold">#@order.Id</td>
                            <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                            <td>@order.CustomerName</td>
                            <td>@order.Phone</td>
                            <td>@order.Address</td>
                            <td class="text-danger fw-bold">@order.TotalAmount.ToString("#,##0") đ</td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-info" data-bs-toggle="collapse" data-bs-target="#orderDetail-@order.Id">
                                    Xem
                                </button>
                            </td>
                        </tr>
                        <tr class="collapse bg-light" id="orderDetail-@order.Id">
                            <td colspan="7" class="p-4">
                                <h6 class="text-muted mb-3">Chi tiết sản phẩm (Đơn #@order.Id)</h6>
                                <table class="table table-sm table-bordered bg-white mb-0">
                                    <thead class="table-secondary">
                                        <tr>
                                            <th>Sản phẩm</th>
                                            <th>Đơn giá</th>
                                            <th>Số lượng</th>
                                            <th>Thành tiền</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var detail in order.OrderDetails)
                                        {
                                            <tr>
                                                <td>
                                                    @if (detail.Product != null)
                                                    {
                                                        <i class="fas fa-box text-secondary me-2"></i>
                                                        @detail.Product.Name
                                                    }
                                                    else
                                                    {
                                                        <span class="text-danger">Sản phẩm đã bị xóa</span>
                                                    }
                                                </td>
                                                <td>@detail.UnitPrice.ToString("#,##0") đ</td>
                                                <td>x @detail.Quantity</td>
                                                <td>@((detail.UnitPrice * detail.Quantity).ToString("#,##0")) đ</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle"></i> Chưa có đơn hàng nào.
        </div>
    }
</div>
