@{
    ViewData["Title"] = "Đặt hàng thành công";
}

<div class="container mt-5 mb-5 text-center">
    <div class="py-5">
        <i class="fas fa-check-circle text-success mb-4" style="font-size: 5rem;"></i>
        <h1 class="text-success fw-bold mb-3">Đặt Hàng Thành Công!</h1>
        <p class="text-muted fs-5 mb-5">
            Cảm ơn bạn đã tin tưởng và mua sắm tại TechShop.<br/>
            Đơn hàng của bạn đã được ghi nhận. Chúng tôi sẽ liên hệ sớm nhất để xác nhận và giao hàng.
        </p>
        
        <div class="d-flex justify-content-center gap-3">
            <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm">
                <i class="fas fa-home"></i> Trở về Trang Chủ
            </a>
            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4 py-2 fw-semibold">
                <i class="fas fa-list-alt"></i> Xem đơn hàng vừa đặt (Admin)
            </a>
        </div>
    </div>
</div>
